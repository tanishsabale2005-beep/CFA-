<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CFA Level 1 Elite Study Hub</title>
    <style>
        :root {
            --primary: #0f172a; /* Slate 900 */
            --accent: #2563eb; /* Blue 600 */
            --background: #f8fafc; /* Slate 50 */
            --text-main: #334155;
            --card-bg: #ffffff;
            --success: #10b981;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--background);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 900px;
            width: 100%;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
        }

        header h1 {
            color: var(--primary);
            margin-bottom: 5px;
            font-size: 2.5rem;
        }

        /* Navigation Tabs */
        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 10px;
        }

        .tab-btn {
            padding: 10px 20px;
            background: none;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            border-radius: 5px;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background-color: var(--accent);
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            border: 1px solid #e2e8f0;
        }

        h2 {
            margin-top: 0;
            color: var(--primary);
            font-size: 1.4rem;
            margin-bottom: 15px;
        }

        /* Existing Styles Optimized */
        .calculator-group {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        input[type="number"] {
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            width: 120px;
            font-size: 1rem;
        }

        .btn {
            padding: 10px 20px;
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: opacity 0.2s;
        }

        .btn:hover { opacity: 0.9; }

        .progress-container {
            width: 100%;
            background-color: #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
            height: 25px;
        }

        .progress-bar {
            height: 100%;
            background-color: var(--success);
            width: 0%;
            transition: width 0.4s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

        .topic-list { list-style: none; padding: 0; margin: 0; }
        .topic-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 10px;
            border-bottom: 1px solid #f1f5f9;
        }

        .topic-item label { display: flex; align-items: center; cursor: pointer; flex-grow: 1; }
        .topic-item input[type="checkbox"] { margin-right: 15px; width: 18px; height: 18px; }
        .weight-badge {
            background-color: #dbeafe;
            color: #1e40af;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .completed-text { text-decoration: line-through; color: #94a3b8; }

        /* Timer Styles */
        .timer-display {
            font-size: 3.5rem;
            font-weight: bold;
            color: var(--primary);
            text-align: center;
            margin: 20px 0;
            font-variant-numeric: tabular-nums;
        }
        .timer-controls { display: flex; justify-content: center; gap: 10px; }

        /* Flashcard Styles */
        .flashcard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        .flashcard {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            min-height: 150px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            cursor: pointer;
            position: relative;
            perspective: 1000px;
        }
        .flashcard .formula-title { font-weight: bold; color: var(--accent); margin-bottom: 10px;}
        .flashcard .card-back { display: none; background: #eff6ff; padding: 10px; border-radius: 6px; font-family: monospace; font-size: 1.1rem; text-align: center;}
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>CFA Level 1 Study Hub</h1>
        <p>Master the 300-Hour Journey</p>
    </header>

    <!-- Tabs Navigation -->
    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('tracker')">Dashboard & Tracker</button>
        <button class="tab-btn" onclick="switchTab('timer')">Study Timer</button>
        <button class="tab-btn" onclick="switchTab('formulas')">High-Yield Formulas</button>
    </div>

    <!-- TAB 1: TRACKER -->
    <div id="tracker" class="tab-content active">
        <div class="card">
            <h2>Study Timeline Calculator</h2>
            <div class="calculator-group">
                <input type="number" id="dailyHours" placeholder="Hours/Day" min="1" max="24">
                <button class="btn" onclick="calculateTimeline()">Calculate Days</button>
                <span id="calc-result"></span>
            </div>
        </div>

        <div class="card">
            <h2>Syllabus Progress</h2>
            <div class="progress-container">
                <div class="progress-bar" id="progressBar">0%</div>
            </div>
            <p style="text-align: right; font-size: 0.9rem;">Topics Mastered: <span id="topicCount">0</span>/10</p>
        </div>

        <div class="card">
            <h2>Core Topics Checklist</h2>
            <ul class="topic-list" id="topicList"></ul>
        </div>
    </div>

    <!-- TAB 2: TIMER -->
    <div id="timer" class="tab-content">
        <div class="card" style="text-align: center;">
            <h2>Focus Study Timer</h2>
            <p>Use 45-minute blocks for high-intensity finance study.</p>
            <div class="timer-display" id="timerDisplay">45:00</div>
            <div class="timer-controls">
                <button class="btn" id="startBtn" onclick="toggleTimer()">Start Focus Session</button>
                <button class="btn" style="background-color: #64748b;" onclick="resetTimer()">Reset</button>
            </div>
        </div>
    </div>

    <!-- TAB 3: FORMULAS -->
    <div id="formulas" class="tab-content">
        <div class="card">
            <h2>High-Yield Flashcards</h2>
            <p>Click a card to reveal the hidden formula.</p>
            <div class="flashcard-grid">
                <div class="flashcard" onclick="toggleCard(this)">
                    <div>
                        <div class="formula-title">Sharpe Ratio</div>
                        <p style="font-size: 0.85rem; color:#64748b;">Measures risk-adjusted return per unit of total risk.</p>
                    </div>
                    <div class="card-back">(Rp - Rf) / σp</div>
                </div>

                <div class="flashcard" onclick="toggleCard(this)">
                    <div>
                        <div class="formula-title">DuPont Analysis (3-Step)</div>
                        <p style="font-size: 0.85rem; color:#64748b;">Breaks down Return on Equity (ROE).</p>
                    </div>
                    <div class="card-back">Profit Margin × Asset Turnover × Leverage</div>
                </div>

                <div class="flashcard" onclick="toggleCard(this)">
                    <div>
                        <div class="formula-title">Cost of Equity (CAPM)</div>
                        <p style="font-size: 0.85rem; color:#64748b;">Capital Asset Pricing Model.</p>
                    </div>
                    <div class="card-back">Rf + β × [E(Rm) - Rf]</div>
                </div>

                <div class="flashcard" onclick="toggleCard(this)">
                    <div>
                        <div class="formula-title">Effective Annual Rate (EAR)</div>
                        <p style="font-size: 0.85rem; color:#64748b;">Accounts for compounding effects over a year.</p>
                    </div>
                    <div class="card-back">(1 + r/m)^m - 1</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Tab Switching Logic
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        
        document.getElementById(tabId).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    // 2. Tracker Logic
    const topics = [
        { name: "Ethical and Professional Standards", weight: "15-20%" },
        { name: "Quantitative Methods", weight: "8-12%" },
        { name: "Economics", weight: "8-12%" },
        { name: "Financial Statement Analysis", weight: "13-17%" },
        { name: "Corporate Issuers", weight: "8-12%" },
        { name: "Equity Investments", weight: "10-12%" },
        { name: "Fixed Income", weight: "10-12%" },
        { name: "Derivatives", weight: "5-8%" },
        { name: "Alternative Investments", weight: "5-8%" },
        { name: "Portfolio Management", weight: "5-8%" }
    ];

    const topicListElement = document.getElementById('topicList');
    topics.forEach((topic, index) => {
        const li = document.createElement('li');
        li.className = 'topic-item';
        li.innerHTML = `
            <label for="topic-${index}">
                <input type="checkbox" id="topic-${index}" onchange="updateProgress(this)">
                <span>${topic.name}</span>
            </label>
            <span class="weight-badge">${topic.weight}</span>
        `;
        topicListElement.appendChild(li);
    });

    function updateProgress(checkbox) {
        checkbox.nextElementSibling.classList.toggle('completed-text', checkbox.checked);
        const checkboxes = document.querySelectorAll('.topic-item input[type="checkbox"]');
        let completed = Array.from(checkboxes).filter(c => c.checked).length;
        const percentage = Math.round((completed / checkboxes.length) * 100);
        
        document.getElementById('progressBar').style.width = `${percentage}%`;
        document.getElementById('progressBar').textContent = percentage > 0 ? `${percentage}%` : '';
        document.getElementById('topicCount').textContent = completed;
    }

    function calculateTimeline() {
        const hours = document.getElementById('dailyHours').value;
        const result = document.getElementById('calc-result');
        if (hours > 0 && hours <= 24) {
            const days = Math.ceil(300 / hours);
            result.innerHTML = `Target reached in roughly <strong>${days} days</strong> (${(days/30).toFixed(1)} months).`;
        }
    }

    // 3. Timer Logic (45 Mins Focus)
    let timer;
    let timeLeft = 45 * 60; 
    let isRunning = false;

    function toggleTimer() {
        const btn = document.getElementById('startBtn');
        if (isRunning) {
            clearInterval(timer);
            btn.textContent = "Resume Session";
            isRunning = false;
        } else {
            isRunning = true;
            btn.textContent = "Pause Session";
            timer = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    alert("Focus session complete! Take a 5-minute break.");
                    resetTimer();
                }
            }, 1000);
        }
    }

    function resetTimer() {
        clearInterval(timer);
        timeLeft = 45 * 60;
        isRunning = false;
        document.getElementById('startBtn').textContent = "Start Focus Session";
        updateTimerDisplay();
    }

    function updateTimerDisplay() {
        const mins = Math.floor(timeLeft / 60).toString().padStart(2, '0');
        const secs = (timeLeft % 60).toString().padStart(2, '0');
        document.getElementById('timerDisplay').textContent = `${mins}:${secs}`;
    }

    // 4. Flashcard Logic
    function toggleCard(card) {
        const back = card.querySelector('.card-back');
        back.style.display = (back.style.display === 'block') ? 'none' : 'block';
    }
</script>

</body>
</html>
